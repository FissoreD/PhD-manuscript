{
    "files.exclude": {
        "**/*.log": true,
        "**/*.vtc": true,
        "**/*.aux": true,
        "**/*.out": true,
        "**/*.bbl": true,
        "**/*.blg": true,
        "**/*.fdb_latexmk": true,
        "**/*.fls": true,
        "**/*.synctex.gz": true,
        "**/*.lbl": true,
        "**/*.loe": true,
        "**/*.lof": true,
        "**/*.toc": true,
        "**/*.mtc*": true,
        "**/*.xmpi": true,
        "**/*.maf": true,
        "**/.latexminted_config": true,
        "**/elpi.py": true,
        "**/_minted": true,
        "code/*.tex": true,
    },
    // "latex-workshop.latex.external.build.command": "make",
    "latex-workshop.latex.outDir": ".aux",
    "latex-workshop.latex.autoBuild.run": "never",
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-interaction=nonstopmode",
                "--shell-escape",
                "-synctex=1",
                "-file-line-error",
                "-recorder",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex",
            "tools": [ "pdflatex", ]
        }
    ],
    "latex-workshop.latex.recipe.default": "lastUsed"
}