
\newcommand{\ruleInfer}[2]{\customlabel{#1}{(\ensuremath{\text{\procfont tm}{{\text{\procfont i}}\atop{#2}}})}}

\newcommand{\ruleIVar}{\ruleInfer{rule:infer-var}{k}}
\newcommand{\iV}{
  \begin{bprooftree}
    \AxiomC{\ensuremath{\ctx~ s = \tau }}
    \RightLabel{\rulelabel{\ruleIVar}}
    \UnaryInfC{\iC{\ctx}{s}{\tau}{\top}}
  \end{bprooftree}
}
\newcommand{\ruleIAppStar}{\ruleInfer{rule:infer-app-data}{\star}}
\newcommand{\iAS}{
  \begin{bprooftree}
    \AxiomC{\ensuremath{\iC{\ctx}{f}{\expI \toI \tau}{b}}}
    \RightLabel{\rulelabel{\ruleIAppStar}}
    \UnaryInfC{\iC{\ctx}{f~d}{\tau}{b}}
  \end{bprooftree}
}
\newcommand{\ruleIAppIt}{\ruleInfer{rule:infer-app-it}{\top}}
\newcommand{\iAIt}{
  \begin{bprooftree}
    \AxiomC{\ensuremath{
        \iC{\ctx}{f}{\rho \toI \tau}{\top} \qquad
            \iC{\ctx}{t}{\rho'}{\top} \qquad
            \rho' \mySub \rho
        }}
    \RightLabel{\rulelabel{\ruleIAppIt}}
    \UnaryInfC{\iC{\ctx}{f~t}{\tau}{\top}}
  \end{bprooftree}
}
\newcommand{\ruleIAppIb}{\ruleInfer{rule:infer-app-ib}{\bot}}
\newcommand{\iAIb}{
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \iC{\ctx}{f}{\rho \toI \tau}{b_1} \qquad
      \iC{\ctx}{t}{\rho'}{b_2} \qquad
      b_1 = \bot \lor b_2 = \bot \lor \rho' \not\mySub \rho
      }}
    \RightLabel{\rulelabel{\ruleIAppIb}}
    \UnaryInfC{\iC{\ctx}{f~t}{\maximize\ \tau}{\bot}}
  \end{bprooftree}
}
\newcommand{\ruleIAppO}{\ruleInfer{rule:infer-app-o}{o}}
\newcommand{\iAO}{
  \begin{bprooftree}
    \AxiomC{\iC{\ctx}{f}{\_ \toO \tau}{b}}
    \RightLabel{\rulelabel{\ruleIAppO}}
    \UnaryInfC{\iC{\ctx}{f\ t}{\tau}{b}}
  \end{bprooftree}
}


