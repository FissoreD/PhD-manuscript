% \newcommand{\centerCmd}[2]{\makebox[\widthof{#1}][c]{#2}}
\newcommand{\centerCmd}[2]{#2}

\newcommand{\ruleImplM}{
  \begin{prooftree}
    % IMPL
    \AxiomC{\ensuremath{\runCmdR{\ConsHdNP{\goalCmd{h +_\Rightarrow \prog}{\centerCmd{\implCmd{h}{t}}{t}}{\altsV}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}}
    \RightLabel{\rulelabel{\ruleImpl}}
    \UnaryInfC{\ensuremath{\runCmdR{\ConsHdNP{\goalCmd{\centerCmd{$h +_\Rightarrow \prog$}{\prog}}{\implCmd{h}{t}}{\altsV}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}}
  \end{prooftree}
}

\newcommand{\rulePiM}{
  \begin{prooftree}
    % PI
    \AxiomC{\ensuremath{y \# \prog \quad \runCmdR{\ConsHdNP{\goalCmd{y +_\forall \prog}{\centerCmd{\piCmd{x}{t}}{$t[x/y]$}}{\altsV}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}}
    \RightLabel{\rulelabel{\rulePi}}
    \UnaryInfC{\ensuremath{\quad\qquad\runCmdR{\ConsHdNP{\goalCmd{\centerCmd{$y +_\forall \prog$}{\prog}}{\piCmd{x}{t}}{\altsV}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}}
  \end{prooftree}
}