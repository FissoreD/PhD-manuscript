

\newcommand{\ruleName}[2]{\runE[#2]}

\newcommand{\ruleFail}{\ruleName{rule:backtrack}{\circlearrowright }}
\newcommand{\ruleAbort}{\ruleName{rule:abort}{\bot}}
\newcommand{\ruleCall}{\ruleName{rule:call}{\backchain}}
\newcommand{\ruleCallF}{\ruleName{rule:callbacktrack}{\circlearrowright}}
\newcommand{\ruleCallFH}{\ruleName{rule:callabort}{\bot}}
\newcommand{\ruleCallB}{\ruleName{rule:call1}{@'}}
\newcommand{\ruleBeta}{\ruleName{rule:beta}{\subst}}
\newcommand{\ruleBang}{\ruleName{rule:cut}{!}}
\newcommand{\ruleStop}{\ruleName{rule:stop}{\top}}
\newcommand{\ruleUnif}{\ruleName{rule:unif}{=}}
\newcommand{\ruleImpl}{\ruleName{rule:impl}{\Rightarrow}}
\newcommand{\rulePi}{\ruleName{rule:pi}{\forall}}
\newcommand{\ruleMatch}{\ruleName{rule:match}{m}}
\newcommand{\rulePiImpl}{\ruleName{rule:piimpl}{{\piimpl}}}

\newcommand{\altsV}[1][]{{\alts[#1]}}
\newcommand{\gV}[1][]{g}

\newcommand{\ruleStopM}{
  \begin{prooftree}
    % STOP
    \AxiomC{\phantom{\ensuremath{\backchainE}}}
    \RightLabel{\rulelabel{\ruleStop}}
    \UnaryInfC{\runCmd{\EmptyList}{\altsV}{\subst}{\altsV}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleUnifM}{
  \begin{prooftree}
    % UNIF
    \AxiomC{\unifyCmd{x}{y}{\subst}{\subst[']}}
    \AxiomC{\runCmdR{\gV}{\altsV}{\subst[']}}
    \RightLabel{\rulelabel{\ruleUnif}}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{\gV}}{\altsV}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleMatchM}{
  \begin{prooftree}
    % MATCH
    \AxiomC{\matchCmd{x}{y}{\subst}{\subst[']}}
    \AxiomC{\runCmd{\gV}{\altsV}{\subst[']}{\altsV[']}{\subst['']}}
    \RightLabel{\rulelabel{\ruleMatch}}
    \BinaryInfC{\runCmd{\ConsHdNP{\goalCmd{\_}{(x =_m y)}{\_}}\ConsTlNP{\gV}}{\altsV}{\subst}{\altsV[']}{\subst['']}}
  \end{prooftree}
}

\newcommand{\ruleFailM}{
  \begin{prooftree}
    % FAIL
    \AxiomC{\unifyCmd{x}{y}{\subst}{\bot}}
    \AxiomC{\runCmdQR{\altsV}{as}}
    \RightLabel{\rulelabel{\ruleFail}}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{\_}}{\ConsHd{\altsV}\ConsTl{as}}{\subst}}
  \end{prooftree}%
}

\newcommand{\ruleAbortM}{
  \begin{prooftree}
    % FAIL
    \AxiomC{\unifyCmd{x}{y}{\subst}{\bot}}
    \RightLabel{\rulelabel{\ruleAbort}}
    \UnaryInfC{\runCmdF{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{\_}}{\EmptyList}{\subst}}
  \end{prooftree}%
}

\newcommand{\ruleBangM}{
  \begin{prooftree}
    % CUT
    \AxiomC{\runCmdR{\gV}{\altsV}{\subst}}
    \RightLabel{\rulelabel{\ruleBang}}
    \UnaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{\cut}{\altsV}}\ConsTlNP{\gV}}{\_}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleCallM}{
  \begin{prooftree}
    % CALL
    \AxiomC{$\backchainE(\prog, (\subst\ t), \subst, \altsV, \gV) = \altsV'$}
    \AxiomC{\runCmdQR{(\altsV'\ \atsign\ \altsV)}}
    \RightLabel{\rulelabel{\ruleCall}}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{\callCmd{t}}{\_}}\ConsTlNP{\gV}}{\altsV}{\subst}}
  \end{prooftree}
}
\newcommand{\ruleCallMF}{
  \begin{prooftree}
    % CALL
    \AxiomC{$\backchainE(\prog, \subst, c, \gV, (a::as)) = \EmptyList$}
    \AxiomC{\runCmdQR{a}{as}}
    \RightLabel{\rulelabel{\ruleCallF}}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{\callCmd{c}}{\_}}\ConsTlNP{\gV}}{(a :: as)}{\subst}}
  \end{prooftree}
}
\newcommand{\ruleCallMFH}{
  \begin{prooftree}
    % CALL
    \AxiomC{\phantom{A}}
    \RightLabel{\rulelabel{\ruleCallFH}}
    \UnaryInfC{$\runE\ \EmptyList \arr \mathrm{None}$}
  \end{prooftree}
}

\newcommand{\ruleCallBeta}{
  \begin{prooftree}
    \AxiomC{$\subst \cdot c = c' \qquad c \neq c' \qquad {\runCmdR{\ConsHdNP{\goalCmd{\prog}{c'}{a}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}$}
    \RightLabel{\rulelabel{\ruleBeta}}
    \UnaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{c}{a}}\ConsTlNP{\gV}}{\altsV[']}{\subst}}
  \end{prooftree}
}


