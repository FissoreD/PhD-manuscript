\newcommand{\rulePiImplM}{
  \begin{prooftree}
    % IMPL
    \AxiomC{$y \mathrm{~fresh}$}
    \AxiomC{\runCmdR{\ConsHdNP{\goalCmd{r[y/x] :: \prog}{g[y/x]}{\altsV}}\ConsTlNP{\gV}}{as}{\subst}}
    \RightLabel{\rulelabel{\rulePiImpl}}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{(\piCmd{x}{\implCmd{r }{g}})}{\altsV}}\ConsTlNP{\gV}}{as}{\subst}}
  \end{prooftree}
}

