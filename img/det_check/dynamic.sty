

\newcommand{\ruleName}[2]{\customlabel{#1}{\ensuremath{\mathrm{run}_{#2}}}}

\newcommand{\ruleFail}{\ruleName{rule:backtrack}{\circlearrowright }}
\newcommand{\ruleAbort}{\ruleName{rule:abort}{\bot}}
\newcommand{\ruleCall}{\ruleName{rule:call}{@}}
\newcommand{\ruleCallF}{\ruleName{rule:callbacktrack}{\circlearrowright}}
\newcommand{\ruleCallFH}{\ruleName{rule:callabort}{\bot}}
\newcommand{\ruleCallB}{\ruleName{rule:call1}{@'}}
\newcommand{\ruleBeta}{\ruleName{rule:beta}{\subst}}
\newcommand{\ruleBang}{\ruleName{rule:cut}{!}}
\newcommand{\ruleStop}{\ruleName{rule:stop}{\top}}
\newcommand{\ruleUnif}{\ruleName{rule:unif}{=}}
\newcommand{\ruleImpl}{\ruleName{rule:impl}{\Rightarrow}}
\newcommand{\rulePi}{\ruleName{rule:pi}{\forall}}
\newcommand{\ruleMatch}{\ruleName{rule:match}{m}}
\newcommand{\rulePiImpl}{\ruleName{rule:piimpl}{{\piimpl}}}

\newcommand{\ruleStopM}{
  \begin{prooftree}
    % STOP
    \AxiomC{\phantom{\ensuremath{\backchain}}}
    \RightLabelM{\ruleStop}
    \UnaryInfC{\runCmd{\EmptyList}{as}{\subst}{as}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleUnifM}{
  \begin{prooftree}
    % UNIF
    \AxiomC{\unifyCmd{x}{y}{\subst}{\subst[']}}
    \AxiomC{\runCmdR{gs}{\alts}{\subst[']}}
    \RightLabelM{\ruleUnif}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{gs}}{\alts}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleMatchM}{
  \begin{prooftree}
    % MATCH
    \AxiomC{\matchCmd{x}{y}{\subst}{\subst[']}}
    \AxiomC{\runCmd{gs}{\alts}{\subst[']}{\alts[']}{\subst['']}}
    \RightLabelM{\ruleMatch}
    \BinaryInfC{\runCmd{\ConsHdNP{\goalCmd{\_}{(x =_m y)}{\_}}\ConsTlNP{gs}}{\alts}{\subst}{\alts[']}{\subst['']}}
  \end{prooftree}
}

\newcommand{\ruleFailM}{
  \begin{prooftree}
    % FAIL
    \AxiomC{\unifyCmd{x}{y}{\subst}{\bot}}
    \AxiomC{\runCmdQR{\alts}{as}}
    \RightLabelM{\ruleFail}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{\_}}{\ConsHd{\alts}\ConsTl{as}}{\subst}}
  \end{prooftree}%
}

\newcommand{\ruleAbortM}{
  \begin{prooftree}
    % FAIL
    \AxiomC{\unifyCmd{x}{y}{\subst}{\bot}}
    \RightLabelM{\ruleAbort}
    \UnaryInfC{\runCmdF{\ConsHdNP{\goalCmd{\_}{x = y}{\_}}\ConsTlNP{\_}}{\EmptyList}{\subst}}
  \end{prooftree}%
}

\newcommand{\ruleBangM}{
  \begin{prooftree}
    % CUT
    \AxiomC{\runCmdR{gs}{\alts}{\subst}}
    \RightLabelM{\ruleBang}
    \UnaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\_}{\cut}{\alts}}\ConsTlNP{gs}}{\_}{\subst}}
  \end{prooftree}
}

\newcommand{\ruleCallM}{
  \begin{prooftree}
    % CALL
    \AxiomC{$\backchain(\prog, \subst, c, gs, as) = as'$}
    \AxiomC{\runCmdQR{(as'\ \atsign\ as)}}
    \RightLabelM{\ruleCall}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{\callCmd{c}}{\_}}\ConsTlNP{gs}}{as}{\subst}}
  \end{prooftree}
}
\newcommand{\ruleCallMF}{
  \begin{prooftree}
    % CALL
    \AxiomC{$\backchain(\prog, \subst, c, gs, (a::as)) = \EmptyList$}
    \AxiomC{\runCmdQR{a}{as}}
    \RightLabelM{\ruleCallF}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{\callCmd{c}}{\_}}\ConsTlNP{gs}}{(a :: as)}{\subst}}
  \end{prooftree}
}
\newcommand{\ruleCallMFH}{
  \begin{prooftree}
    % CALL
    \AxiomC{\phantom{A}}
    \RightLabelM{\ruleCallFH}
    \UnaryInfC{$\runE\ \EmptyList \arr \bot$}
  \end{prooftree}
}

\newcommand{\ruleCallBeta}{
  \begin{prooftree}
    \AxiomC{$\subst \cdot c = c' \qquad c \neq c' \qquad {\runCmdR{\ConsHdNP{\goalCmd{\prog}{c'}{a}}\ConsTlNP{gs}}{as}{\subst}}$}
    \RightLabelM{\ruleBeta}
    \UnaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{c}{a}}\ConsTlNP{gs}}{as}{\subst}}
  \end{prooftree}
}


