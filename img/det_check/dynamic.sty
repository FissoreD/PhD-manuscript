\newcommand{\rulePiImplM}{
  \begin{prooftree}
    % IMPL
    \AxiomC{$y \mathrm{~fresh}$}
    \AxiomC{\runCmdR{\ConsHdNP{\goalCmd{r[y/x] :: \prog}{g[y/x]}{\alts}}\ConsTlNP{gs}}{as}{\subst}}
    \RightLabelM{\rulePiImpl}
    \BinaryInfC{\runCmdR{\ConsHdNP{\goalCmd{\prog}{(\piCmd{x}{\implCmd{r }{g}})}{\alts}}\ConsTlNP{gs}}{as}{\subst}}
  \end{prooftree}
}

