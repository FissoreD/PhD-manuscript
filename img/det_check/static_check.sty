\newcommand{\ruleCAcut}{\ruleCheckAtomName{rule:check-atom-cut}{!}}
\newcommand{\caCUT}{
  % CONS
  \begin{bprooftree}
    \AxiomC{}
    \RightLabelM{\ruleCAcut}
    \UnaryInfC{\caC{\prog}{\ctx}{\_}{\cut}{\detI}{\ctx}}
  \end{bprooftree}
}


\newcommand{\ruleCApi}{\ruleCheckAtomName{rule:check-atom-pi}{\forall}}
\newcommand{\caPI}{
  % CONS
  \begin{bprooftree}
    \AxiomC{
       \stackanchor{\ensuremath{%
      x \mathrm{~fresh~in~} \ctx \qquad
      \ccC{\prog}{\ctx + \{x \mapsto \star \}}{x}{r}
      }}
      {\ensuremath{%
      \mutExclAll\ \prog\ \ctx\ x\ r \qquad
      \caC{(r :: \prog)}{\ctx + \{x \mapsto \star \}}{\func}{a}{\func'}{\ctx'}}}
    }
    \RightLabelM{\ruleCApi}
    \UnaryInfC{\caC{\prog}{\ctx}{\func}{\piImplCmd{x}{r}{a}}{\func'}{\ctx'}}
  \end{bprooftree}
}

\newcommand{\ruleCAcall}{\ruleCheckAtomName{rule:check-atom-call}{c}}
\newcommand{\caCALL}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \iC{\ctx}{c}{\func'}{\top} \qquad
      \caoC{\ctx}{c}{\func'}{\ctx'}
    }}
    \RightLabelM{\ruleCAcall}
    \UnaryInfC{\caC{\prog}{\ctx}{\func}{c}{\maxT~\func~\func'}{\ctx'}}
  \end{bprooftree}
}

\newcommand{\ruleCAmiscall}{\ruleCheckAtomName{rule:check-atom-miscall}{\bot}}
\newcommand{\caMISCALL}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \iC{\ctx}{c}{\relI}{\bot} \qquad
    }}
    \RightLabelM{\ruleCAmiscall}
    \UnaryInfC{\caC{\prog}{\ctx}{\_}{c}{\relI}{\ctx}}
  \end{bprooftree}
}


\newcommand{\ruleCHDi}{\ruleCheckHeadInName{rule:check-head-input-out}{o}}
\newcommand{\cHDi}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \chiC{\ctx}{f}{\_ \toO \tau}{\ctx'} \quad\lor\quad \chiC{\ctx}{f}{\star \toI \tau}{\ctx'}
    }}
    \RightLabelM{\ruleCHDi}
    \UnaryInfC{\chiC{\ctx}{f~t}{\tau}{\ctx'}}
  \end{bprooftree}
}
\newcommand{\ruleCHDo}{\ruleCheckHeadInName{rule:check-head-input-in}{i}}
\newcommand{\cHDo}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \chiC{\ctx}{f}{\rho \toI \tau}{\ctx'} \qquad
      \aC{\ctx'}{t}{\rho}{\ctx''}
    }}
    \RightLabelM{\ruleCHDo}
    \UnaryInfC{\chiC{\ctx}{f~t}{\tau}{\ctx''}}
  \end{bprooftree}
}
\newcommand{\ruleCHDf}{\ruleCheckHeadInName{rule:check-head-head-input-k}{k}}
\newcommand{\cHDf}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \ctx~k = \tau
    }}
    \RightLabelM{\ruleCHDf}
    \UnaryInfC{\chiC{\ctx}{k}{\tau}{\ctx}}
  \end{bprooftree}
}

\newcommand{\ruleCAOi}{\ruleCheckAtomOutName{rule:check-atom-output-out}{o}}
\newcommand{\cAOi}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \caoC{\ctx}{f}{\rho \toO \tau}{\ctx'} \qquad
      \aC{\ctx'}{t}{\rho}{\ctx''}
    }}
    \RightLabelM{\ruleCAOi}
    \UnaryInfC{\caoC{\ctx}{f~t}{\tau}{\ctx''}}
  \end{bprooftree}
}
\newcommand{\ruleCAOo}{\ruleCheckAtomOutName{rule:check-atom-output-in}{i}}
\newcommand{\cAOo}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \caoC{\ctx}{f}{\_ \toI \tau}{\ctx} \qquad
    }}
    \RightLabelM{\ruleCAOo}
    \UnaryInfC{\caoC{\ctx}{f~t}{\tau}{\ctx}}
  \end{bprooftree}
}
\newcommand{\ruleCAOf}{\ruleCheckAtomOutName{rule:check-atom-output-k}{k}}
\newcommand{\cAOf}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \ctx~s = \tau 
    }}
    \RightLabelM{\ruleCAOf}
    \UnaryInfC{\caoC{\ctx}{s}{\tau}{\ctx}}
  \end{bprooftree}
}


\newcommand{\rulevHDi}{\ruleCheckHeadOutName{rule:check-head-output-in}{i}}
\newcommand{\vHDi}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \choC{\ctx}{f}{\_ \toI \tau} \quad \lor \quad \choC{\ctx}{f}{\star \toO \tau}
    }}
    \RightLabelM{\rulevHDi}
    \UnaryInfC{\choC{\ctx}{f~t}{\tau}}
  \end{bprooftree}
}
\newcommand{\rulevHDo}{\ruleCheckHeadOutName{rule:check-head-output-out}{o}}
\newcommand{\vHDo}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \choC{\ctx}{f}{\rho \toO \tau} \qquad
      \iC{\ctx}{t}{\rho'}{\top} \qquad
      \rho' \mySub \rho
    }}
    \RightLabelM{\rulevHDo}
    \UnaryInfC{\choC{\ctx}{f~t}{\tau}}
  \end{bprooftree}
}
\newcommand{\rulevHDf}{\ruleCheckHeadOutName{rule:check-head-output-k}{k}}
\newcommand{\vHDf}{
  % CONS
  \begin{bprooftree}
    \AxiomC{\ensuremath{
      \ctx~k = \tau' \qquad \tau \mySub \tau'
    }}
    \RightLabelM{\rulevHDf}
    \UnaryInfC{\choC{\ctx}{k}{\tau}}
  \end{bprooftree}
}



\newcommand{\ruleCR}{\ruleCheckRuleName{rule:check-rule}{}}
\newcommand{\ccM}{
  % CONS
  \begin{bprooftree}
    \AxiomC{
      % \Shortstack{
      % {\qquad\qquad\qquad\quad \ensuremath{
      %   %\mutExclAll\ \prog\ \ctx\ (c\ \cdash\ b_1 \ldots b_n) \qquad
      %   }}
        {\ensuremath{
          \chiC{\ctx}{c}{\func_1}{\ctx_1} \quad
        \forall i \in 1 \ldots n \mathrm{~do~} \caC{\prog}{\ctx_i}{\func_i}{b_i}{\func_{i+1}}{\ctx_{i+1}} \quad
        % \mathrm{for~} i = 1\ldots n\mathrm{~do~} \caC{\prog}{\ctx_i}{\func_i}{b_i}{\func_{i+1}}{\ctx_{i+1}} \quad
        \choC{\ctx_{n+1}}{c}{\func_{n+1}}
      }} %}
    }
    \RightLabelM{\ruleCR}
    \UnaryInfC{\ccC{\prog}{\ctx}{x}{c\ \cdash\ b_1 \ldots b_n}}
  \end{bprooftree}
}
