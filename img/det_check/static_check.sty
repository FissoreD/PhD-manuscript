\newcommand{\ruleCheckHeadInName}[2]{\customlabel{#1}{(\ensuremath{\text{\procfont hd}{\text{\procfont i}\atop{#2}}})}}
\newcommand{\ruleCheckHeadOutName}[2]{\customlabel{#1}{(\ensuremath{\text{\procfont hd}{\text{\procfont o}\atop{#2}}})}}
\newcommand{\ruleCheckAtomName}[2]{\customlabel{#1}{(\ensuremath{\text{\procfont a}_{#2}})}}
\newcommand{\ruleCheckAtomOutName}[2]{\customlabel{#1}{(\ensuremath{\text{\procfont a}{\text{\procfont o}\atop{#2}}})}}

