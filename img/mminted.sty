\usepackage{minted}
\newcommand{\elpiIn}[1]{\text{\mintinline[fontsize=\small,escapeinside=~~]{elpi}{#1}}}
\newcommand{\coqIn}[1]{\text{\mintinline[fontsize=\small,escapeinside=~~]{coq}{#1}}}
\newcommand{\eI}[1]{\text{\elpiIn{#1}}}
\newcommand{\cI}[1]{\text{\coqIn{#1}}}

\newcommand{\mintopt}{fontsize=\small,autogobble,escapeinside=~~,mathescape=true,frame=leftline,framerule=0pt,framesep=1em}

\newenvironment{mminted}[1]{%
  % \vspace{0.2em}%
  \VerbatimEnvironment
  \begin{minted}[fontsize=\small,autogobble,escapeinside=~~,mathescape=true,frame=leftline,framerule=0pt,framesep=1em]{#1}%
}{%
  \end{minted}%
  % \vspace{0.2em}%
}

\newenvironment{coqcode}{%
  \VerbatimEnvironment
  \begin{mminted}{coq}%
}{%
  \end{mminted}%
}

\newenvironment{elpicode}{%
  \VerbatimEnvironment
  \begin{mminted}{elpi.py:ElpiLexer}%
    }{%
  \end{mminted}%
}