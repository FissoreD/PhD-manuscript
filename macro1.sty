\newcommand{\mvspace}{\vspace{5pt}}

\newcommand{\mcenter}[1]{
  {
      \mvspace
      \centering
      \input{#1}\par
      \mvspace
    }
}

\newcommand{\mleft}[1]{
  {
    \mvspace
    \input{#1}\par
    \mvspace
  }
}

\newcommand{\paragraphTwo}[2][subsubsection]{
  \paragraph*{#2}
  \addcontentsline{toc}{#1}{\texorpdfstring{$\quad$}{}#2}
}

\newcommand{\subsectionTwo}[2][subsection]{
  \subsection*{#2}
  \addcontentsline{toc}{#1}{\texorpdfstring{$\quad$}{}#2}
}

\newcommand{\subsubsectionTwo}[2][subsubsection]{
  \subsubsection*{#2}
  \addcontentsline{toc}{#1}{\texorpdfstring{$\quad$}{}#2}
}

